{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "SvelteKit: Server Debug",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "pnpm",
        "run",
        "dev",
        "--open"
      ],
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ],
      "console": "integratedTerminal",
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ]
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "SvelteKit: Client Debug",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "SvelteKit: Full Stack Debug",
      "configurations": [
        "SvelteKit: Server Debug",
        "SvelteKit: Client Debug"
      ]
    }
  ]
}

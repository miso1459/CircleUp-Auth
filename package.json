{
	"name": "circleup-auth",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "cross-env NODE_ENV=production node server.js",
		"start:dev": "cross-env NODE_ENV=development node server.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@better-auth/cli": "latest",
		"@eslint/compat": "latest",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.2.8",
		"@inlang/paraglide-js": "^2.18.0",
		"@internationalized/date": "^3.12.1",
		"@lucide/svelte": "^1.17.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.60.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^24.12.4",
		"better-auth": "~1.4.22",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"cross-env": "^10.1.0",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^17.6.0",
		"lucide-svelte": "^1.0.1",
		"mdsvex": "^0.12.7",
		"p-retry": "^8.0.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"shadcn-svelte": "^1.2.7",
		"svelte": "^5.55.7",
		"svelte-check": "^4.4.8",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.3",
		"vite": "^8.0.13"
	},
	"dependencies": {
		"@google/genai": "^2.4.0",
		"@tiptap/core": "^3.23.5",
		"@tiptap/extension-file-handler": "^3.23.5",
		"@tiptap/extension-image": "^3.23.5",
		"@tiptap/extension-link": "^3.23.5",
		"@tiptap/extension-table": "^3.23.5",
		"@tiptap/extension-table-cell": "^3.23.5",
		"@tiptap/extension-table-header": "^3.23.5",
		"@tiptap/extension-table-row": "^3.23.5",
		"@tiptap/extension-text-style": "^3.23.5",
		"@tiptap/extension-youtube": "^3.23.5",
		"@tiptap/pm": "^3.23.5",
		"@tiptap/starter-kit": "^3.23.5",
		"better-sqlite3": "^12.10.0",
		"dotenv-flow": "^4.1.0",
		"gaxios": "^7.1.4",
		"google-auth-library": "^10.6.2",
		"is-network-error": "^1.3.2",
		"ws": "^8.20.1"
	}
}
